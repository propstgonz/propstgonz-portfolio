---
import { aboutme } from '../data/aboutme';
import Avatar from './Avatar.astro';
import Typewriter from './Typewriter.astro';
import Nav from './Nav.astro';

interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;
---
<header class="max-w-[880px] mx-auto px-5 pt-8 pb-6">
  <div class="card p-5 flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-6">
    <div transition:persist transition:name="avatar">
      <Avatar name={aboutme.name} />
    </div>

    <div class="flex-1 min-w-0 flex flex-col justify-center gap-1">
      <h1 class="text-lg font-bold text-amber font-mono leading-none">{aboutme.name}</h1>
      <p class="text-xs text-text3 font-mono">{aboutme.tagline}</p>
      <div transition:persist transition:name="typewriter">
        <Typewriter />
      </div>
    </div>

    <!-- Not persisted on purpose: needs to re-render per page so the
         active nav item stays in sync with the current route. -->
    <Nav activePage={activePage} />
  </div>
</header>
