---
---
<div
  id="consent-banner"
  class="hidden fixed inset-x-0 bottom-0 z-50 animate-fade-up"
  role="region"
  aria-label="Data collection consent"
>
  <div class="max-w-[880px] mx-auto px-5 pb-5">
    <div class="card p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center gap-4 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.6)]">
      <p class="flex-1 min-w-0 font-mono text-[13px] text-text2 leading-relaxed">
        <span class="text-amber font-semibold">$ ./privacy.sh</span>
        — this site would like to log your IP, the pages you open, the
        site you arrived from, and your browser and OS, just to keep
        basic traffic stats (visits/week, unique visitors, popular
        pages). No ads, nothing sold, and these stats stay on my own
        server. Decline and none of that happens — you won't be asked
        again.
      </p>
      <div class="flex gap-2 shrink-0">
        <button
          id="consent-decline"
          type="button"
          class="font-mono text-[13px] px-4 py-2 rounded-lg border border-b1 text-text2 hover:text-text hover:bg-b1/70 transition-colors cursor-pointer"
        >
          Decline
        </button>
        <button
          id="consent-accept"
          type="button"
          class="font-mono text-[13px] font-bold px-4 py-2 rounded-lg text-bg transition-all hover:-translate-y-0.5 cursor-pointer"
          style="background: linear-gradient(135deg, var(--color-amber), var(--color-amber-d));"
        >
          Accept
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const CONSENT_KEY = 'propstgonz-consent';
  const CONSENT_EVENT = 'propstgonz:consent-changed';
  const SESSION_KEY = 'propstgonz-session';

  function sessionId() {
    try {
      let id = sessionStorage.getItem(SESSION_KEY);
      if (!id) {
        id = crypto.randomUUID();
        sessionStorage.setItem(SESSION_KEY, id);
      }
      return id;
    } catch {
      return '';
    }
  }

  function track() {
    if (localStorage.getItem(CONSENT_KEY) !== 'accepted') return;

    fetch('/api/track', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session: sessionId(),
        path: location.pathname,
        referrer: document.referrer,
      }),
    }).catch(() => {
    });
  }

  document.addEventListener('astro:page-load', track);

  const consent = localStorage.getItem(CONSENT_KEY);

  if (consent !== 'accepted' && consent !== 'declined') {
    const banner = document.getElementById('consent-banner');
    const acceptBtn = document.getElementById('consent-accept');
    const declineBtn = document.getElementById('consent-decline');

    if (banner && acceptBtn && declineBtn) {
      banner.classList.remove('hidden');

      acceptBtn.addEventListener('click', () => {
        localStorage.setItem(CONSENT_KEY, 'accepted');
        banner.classList.add('hidden');
        track();
        window.dispatchEvent(new CustomEvent(CONSENT_EVENT));
      });

      declineBtn.addEventListener('click', () => {
        localStorage.setItem(CONSENT_KEY, 'declined');
        banner.classList.add('hidden');
        window.dispatchEvent(new CustomEvent(CONSENT_EVENT));
      });
    }
  }
</script>
