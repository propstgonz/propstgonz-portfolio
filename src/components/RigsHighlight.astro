---
import { computers } from '../data/computers';
import SectionHeader from './SectionHeader.astro';

const pc = computers[0];
---
<a href="/rigs" class="btn-cta group">
  <div class="min-w-0">
    <SectionHeader title="rigs" rule={false} class="mb-2" />
    <p class="text-sm text-text2 font-mono truncate">
      {pc.name} · {pc.os} — full setup, specs & self-hosted stack
    </p>
  </div>
  <span class="btn-cta-arrow" aria-hidden="true">→</span>
</a>
