---
import { logs, LOGS_VISIBLE } from '../data/logs';
import SectionHeader from './SectionHeader.astro';

const visible = logs.slice(0, LOGS_VISIBLE);
const rest = logs.slice(LOGS_VISIBLE);
---
<div class="card p-5">
  <SectionHeader title="changelog" class="mb-3" />

  <ul class="flex flex-col gap-2 font-mono text-sm" id="logs-visible">
    {visible.map(log => (
      <li class="flex gap-3">
        <span class="text-text3 shrink-0">{log.date}</span>
        <span class="text-text2">{log.message}</span>
      </li>
    ))}
  </ul>

  {rest.length > 0 && (
    <>
      <ul class="flex-col gap-2 font-mono text-sm mt-2 hidden" id="logs-rest">
        {rest.map(log => (
          <li class="flex gap-3">
            <span class="text-text3 shrink-0">{log.date}</span>
            <span class="text-text2">{log.message}</span>
          </li>
        ))}
      </ul>
      <button
        id="logs-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="logs-rest"
        data-count={rest.length}
        class="text-xs text-text3 hover:text-amber mt-1 py-2 font-mono transition-colors"
      >
        show {rest.length} more ↓
      </button>
    </>
  )}
</div>

<script>
  function setup() {
    const btn = document.getElementById('logs-toggle');
    const restEl = document.getElementById('logs-rest');
    if (!btn || !restEl) return;

    btn.addEventListener('click', () => {
      const isHidden = restEl.classList.contains('hidden');
      restEl.classList.toggle('hidden');
      restEl.classList.toggle('flex');
      btn.setAttribute('aria-expanded', String(isHidden));
      btn.textContent = isHidden ? 'show less ↑' : `show ${btn.dataset.count} more ↓`;
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
