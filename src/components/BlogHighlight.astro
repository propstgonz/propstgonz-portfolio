---
import SectionHeader from './SectionHeader.astro';
---
<a href="/blog" class="btn-cta group">
  <div class="min-w-0">
    <SectionHeader title="blog" rule={false} class="mb-2" />
    <ul id="blog-highlight-list" class="hidden flex-col gap-1 font-mono text-sm text-text2">
    </ul>
    <p id="blog-highlight-fallback" class="text-sm text-text2 font-mono">
      Thoughts, notes and things I broke — read the latest
    </p>
    <p class="text-xs text-text3 font-mono mt-2">Posts written in Spanish</p>
  </div>
  <span class="btn-cta-arrow" aria-hidden="true">→</span>
</a>

<script>
  async function loadLatestPosts() {
    const list = document.getElementById('blog-highlight-list');
    const fallback = document.getElementById('blog-highlight-fallback');
    if (!list || !fallback) return;

    try {
      const res = await fetch('/api/latest-posts');
      const data = (await res.json()) as { posts: { title: string; slug: string }[] };

      if (data.posts.length > 0) {
        list.replaceChildren(
          ...data.posts.map((p) => {
            const li = document.createElement('li');
            li.className = 'truncate capitalize';
            li.textContent = `→ ${p.title}`;
            return li;
          }),
        );
        list.classList.remove('hidden');
        list.classList.add('flex');
        fallback.classList.add('hidden');
      }
    } catch {
    }
  }

  document.addEventListener('astro:page-load', loadLatestPosts);
</script>
