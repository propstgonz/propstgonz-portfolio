<div class="card px-4 py-3 font-mono text-xs text-text3 flex items-center justify-between">
  <span>your ip</span>
  <span id="ip-value" class="text-text2">resolving…</span>
</div>

<script>
  import { initIpDisplay } from '../assets/scripts/whoami';
  // astro:page-load fires on the initial page load too (since Astro
  // 5.4.2), so this listener alone covers both first load and every
  // subsequent navigation — no separate immediate call needed.
  document.addEventListener('astro:page-load', () => initIpDisplay('ip-value'));
  // Re-resolves immediately if the visitor answers the consent banner
  // while this widget is already on screen, instead of only updating on
  // the next navigation.
  window.addEventListener('propstgonz:consent-changed', () => initIpDisplay('ip-value'));
</script>
