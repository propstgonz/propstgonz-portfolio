---
import type { LinkCategory } from '../types/link';
import SectionHeader from './SectionHeader.astro';

interface Props {
  category: LinkCategory;
}

const { category } = Astro.props;
---
{category.items.length > 0 && (
  <section>
    <SectionHeader title={category.name} class="mb-4" />
    <div class="flex flex-col gap-3">
      {category.items.map(item => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-cta group"
        >
          <div class="min-w-0">
            <p class="font-mono text-sm text-text group-hover:text-amber transition-colors">{item.label}</p>
            {item.description && (
              <p class="text-xs text-text3 font-mono mt-1 line-clamp-2">{item.description}</p>
            )}
          </div>
          <span class="btn-cta-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
)}
