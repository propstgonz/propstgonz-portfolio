---
import type { LinkCategory } from '../types/link';

interface Props {
  category: LinkCategory;
}

const { category } = Astro.props;
---
{category.items.length > 0 && (
  <section>
    <div class="sec-hd mb-4">
      <span class="sec-hd-bar"></span>
      <span class="sec-hd-title">{category.name}</span>
      <span class="sec-hd-rule"></span>
    </div>
    <div class="flex flex-col gap-2.5">
      {category.items.map(item => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-cta group"
        >
          <div class="min-w-0">
            <p class="font-mono text-sm text-text group-hover:text-amber transition-colors">{item.label}</p>
            {item.description && (
              <p class="text-[12px] text-text3 font-mono mt-1 truncate">{item.description}</p>
            )}
          </div>
          <span class="text-text3 text-lg group-hover:text-amber group-hover:translate-x-1 transition-all shrink-0" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
)}
