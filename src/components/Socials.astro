---
import { socials } from '../data/socials';
---
<section class="font-mono">
  <div class="sec-hd mb-3">
    <span class="sec-hd-bar"></span>
    <span class="sec-hd-title">socials</span>
    <span class="sec-hd-rule"></span>
  </div>

  <div class="flex gap-3">
    {socials.map(social => (
      <a
        href={social.href}
        target={social.external ? '_blank' : undefined}
        rel={social.external ? 'noopener noreferrer' : undefined}
        title={social.label}
        class="btn-icon"
      >
        <img src={social.icon} alt={social.label} class="w-4.5 h-4.5" loading="lazy" />
      </a>
    ))}
  </div>
</section>
