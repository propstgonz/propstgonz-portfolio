---
---
<div
  id="click-counter"
  class="card py-5 px-6 text-center cursor-pointer select-none relative overflow-hidden hover:border-amber-d hover:bg-amber/5 active:scale-[0.98] transition-all"
  role="button"
  tabindex="0"
  aria-label="Click to add to the counter"
>
  <p class="text-[11px] uppercase tracking-wider text-text3 mb-1 font-mono">total clicks</p>
  <p id="counter-num" class="text-4xl font-bold text-amber font-mono leading-none tracking-tight">···</p>
</div>

<script>
  function fmt(n: number) {
    return n.toLocaleString('es-ES');
  }

  function setCount(numEl: HTMLElement, n: number, animate = false) {
    numEl.textContent = fmt(n);
    if (animate) {
      numEl.classList.remove('bump');
      void numEl.offsetWidth; // reflow to restart the animation
      numEl.classList.add('bump');
    }
  }

  function spawnFloat(card: HTMLElement, x: number, y: number) {
    const f = document.createElement('span');
    f.textContent = '+1';
    f.className = 'float-num';
    f.style.left = `${x}px`;
    f.style.top = `${y}px`;
    card.appendChild(f);
    f.addEventListener('animationend', () => f.remove());
  }

  async function loadInitial(numEl: HTMLElement) {
    try {
      const res = await fetch('/api/counter');
      const data = (await res.json()) as { count: number };
      setCount(numEl, data.count);
    } catch {
      setCount(numEl, 0);
    }
  }

  async function handleClick(card: HTMLElement, numEl: HTMLElement, e: MouseEvent | KeyboardEvent) {
    if (e instanceof KeyboardEvent && e.key !== 'Enter' && e.key !== ' ') return;

    const current = parseInt(numEl.textContent?.replace(/\D/g, '') ?? '0', 10);
    setCount(numEl, current + 1, true);

    if (e instanceof MouseEvent) {
      const rect = card.getBoundingClientRect();
      spawnFloat(card, e.clientX - rect.left - 10, e.clientY - rect.top - 20);
    }

    try {
      const res = await fetch('/api/counter', { method: 'POST' });
      const data = (await res.json()) as { count: number };
      setCount(numEl, data.count);
    } catch {
      /* optimistic count stays */
    }
  }

  // Re-queries the DOM and re-binds on every navigation instead of
  // capturing elements once at module scope — with view transitions the
  // whole widget is a fresh node each time, so a one-time capture used
  // to keep listeners on a detached (invisible) element, leaving the
  // visible counter permanently stuck on "···" after navigating away
  // and back.
  function setup() {
    const card = document.getElementById('click-counter');
    const numEl = document.getElementById('counter-num');
    if (!card || !numEl) return;

    loadInitial(numEl);

    const onClick = (e: MouseEvent | KeyboardEvent) => handleClick(card, numEl, e);
    card.addEventListener('click', onClick);
    card.addEventListener('keydown', onClick);
  }

  // astro:page-load fires on the initial page load too (since Astro
  // 5.4.2) — calling setup() separately as well as listening for this
  // event double-bound the click handler on first load, which is why
  // the counter used to jump by 2 per click instead of 1.
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  #counter-num.bump {
    animation: bump 0.25s ease;
  }

  @keyframes bump {
    0% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }

  :global(.float-num) {
    position: absolute;
    font-size: 18px;
    font-weight: 700;
    color: var(--color-amber);
    pointer-events: none;
    animation: floatUp 0.7s ease forwards;
    font-family: var(--font-mono);
  }

  @keyframes floatUp {
    0% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(-50px); }
  }
</style>
