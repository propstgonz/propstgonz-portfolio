---
---
<button
  id="click-counter"
  type="button"
  class="card w-full py-5 px-6 text-center cursor-pointer select-none relative overflow-hidden hover:border-amber-d hover:bg-amber/5 active:scale-[0.99] transition-colors"
  aria-label="Add one to the global click counter"
>
  <span class="block text-xs uppercase tracking-wider text-text3 mb-1 font-mono">total clicks</span>
  <span id="counter-num" class="block text-4xl font-bold text-amber font-mono leading-none tracking-tight">0</span>
</button>

<script>
  const API_URL = '/api/counter';

  function fmt(n: number) {
    return n.toLocaleString('es-ES');
  }

  async function fetchCount(): Promise<number | null> {
    try {
      const res = await fetch(API_URL);
      if (!res.ok) return null;
      const data = await res.json();
      return typeof data.count === 'number' ? data.count : null;
    } catch {
      return null;
    }
  }

  async function incrementCount(): Promise<number | null> {
    try {
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      if (!res.ok) return null;
      const data = await res.json();
      return typeof data.count === 'number' ? data.count : null;
    } catch {
      return null;
    }
  }

  let liveSource: EventSource | null = null;

  function connectLive() {
    if (liveSource) return;

    liveSource = new EventSource('/api/counter/stream');
    liveSource.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);
        if (typeof data.count !== 'number') return;
        const numEl = document.getElementById('counter-num');
        if (numEl) setDisplay(numEl, data.count, true);
      } catch {
      }
    };
  }

  function setDisplay(numEl: HTMLElement, n: number, animate = false) {
    numEl.textContent = fmt(n);
    if (animate) {
      numEl.classList.remove('bump');
      void numEl.offsetWidth;
      numEl.classList.add('bump');
    }
  }

  function spawnFloat(card: HTMLElement, x: number, y: number) {
    const f = document.createElement('span');
    f.textContent = '+1';
    f.className = 'float-num';
    f.setAttribute('aria-hidden', 'true');
    f.style.left = `${x}px`;
    f.style.top = `${y}px`;
    card.appendChild(f);
    f.addEventListener('animationend', () => f.remove());
  }

  async function handleClick(card: HTMLElement, numEl: HTMLElement, e: MouseEvent) {
    const next = await incrementCount();
    if (next === null) return;

    setDisplay(numEl, next, true);

    if (e.detail > 0) {
      const rect = card.getBoundingClientRect();
      spawnFloat(card, e.clientX - rect.left - 10, e.clientY - rect.top - 20);
    }
  }

  function setup() {
    const card = document.getElementById('click-counter');
    const numEl = document.getElementById('counter-num');
    if (!card || !numEl) return;

    fetchCount().then((n) => {
      if (n !== null) setDisplay(numEl, n);
    });

    connectLive();

    card.addEventListener('click', (e) => handleClick(card, numEl, e));
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  #counter-num.bump {
    animation: bump 0.25s ease;
  }

  @keyframes bump {
    0% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }
</style>
