---
interface Props {
  activePage: string;
}

const { activePage } = Astro.props;

const links = [
  { href: '/', label: 'home' },
  { href: '/rigs', label: 'rigs' },
  { href: '/blog', label: 'blog' },
  { href: '/links', label: 'links' },
  { href: '/faq', label: 'faq' },
];
---
<nav aria-label="Main" class="grid grid-cols-3 sm:flex sm:flex-wrap sm:items-center gap-1 border-t border-b1 pt-3 font-mono text-sm">
  {links.map(link => (
    <a
      href={link.href}
      aria-current={activePage === link.href ? 'page' : undefined}
      class:list={[
        'btn-nav',
        activePage === link.href ? 'btn-nav-active' : 'btn-nav-idle',
      ]}
    >
      {link.label}
    </a>
  ))}
</nav>
