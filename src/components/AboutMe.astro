---
import { aboutme } from '../data/aboutme';
import { tags } from '../data/tags';
import SectionHeader from './SectionHeader.astro';
---
<section class="font-mono">
  <SectionHeader title="about me" class="mb-3" />

  <p class="text-text2 text-sm leading-relaxed mb-4">
    {aboutme.bio}
  </p>

  <div class="flex flex-wrap gap-1.5">
    {tags.map(tag => (
      <span class:list={['tag', `tag-${tag.color}`]}>{tag.label}</span>
    ))}
  </div>
</section>
