---
import { Image } from 'astro:assets';
import { tools } from '../data/tools';
import SectionHeader from './SectionHeader.astro';
---
<div class="card p-5 sm:p-6">
  <SectionHeader title="stack" class="mb-5" />

  <ul class="grid grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-3 font-mono">
    {tools.map(tool => {
      const El = tool.href ? 'a' : 'div';
      return (
        <li>
          <El
            href={tool.href}
            target={tool.href ? '_blank' : undefined}
            rel={tool.href ? 'noopener noreferrer' : undefined}
            class="group h-full flex items-center gap-2.5 sm:gap-3 p-2.5 sm:p-3 rounded-lg border border-b1 bg-bg/40
                   transition-colors hover:border-amber-d hover:bg-amber/5"
          >
            <Image
              src={tool.icon}
              alt=""
              width={32}
              height={32}
              class="w-7 h-7 sm:w-8 sm:h-8 object-contain shrink-0 grayscale-[20%] group-hover:grayscale-0 transition-[filter]"
              loading="lazy"
            />
            <span class="text-sm text-text2 group-hover:text-text transition-colors min-w-0 leading-tight break-normal">
              {tool.name}
            </span>
          </El>
        </li>
      );
    })}
  </ul>
</div>
