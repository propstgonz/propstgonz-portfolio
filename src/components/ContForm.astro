---
---
<div class="sec-hd mb-3">
  <span class="sec-hd-bar"></span>
  <span class="sec-hd-title">reach me</span>
  <span class="sec-hd-rule"></span>
</div>

<form id="contact-form" class="card p-5 flex flex-col gap-3 font-mono">
  <input
    name="name"
    type="text"
    placeholder="name"
    required
    class="w-full p-2.5 rounded-lg border border-b1 bg-bg text-sm text-text placeholder-text3 focus:outline-none focus:ring-1 focus:ring-amber"
  />
  <input
    name="email"
    type="email"
    placeholder="email"
    required
    class="w-full p-2.5 rounded-lg border border-b1 bg-bg text-sm text-text placeholder-text3 focus:outline-none focus:ring-1 focus:ring-amber"
  />
  <textarea
    name="message"
    placeholder="message"
    required
    class="w-full p-2.5 rounded-lg border border-b1 bg-bg text-sm text-text placeholder-text3 focus:outline-none focus:ring-1 focus:ring-amber h-28 resize-none"
  ></textarea>
  <button type="submit" id="contact-submit" class="btn-primary">
    send
  </button>
  <p id="contact-status" class="text-xs text-text3 text-center min-h-[16px]"></p>
</form>

<script>
  // Re-queries and re-binds on every navigation (see ClickCounter.astro
  // for why): otherwise the submit handler stays attached to a detached
  // copy of the form after navigating away and back, and the visible
  // form falls through to a real (broken) browser submit.
  function setup() {
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const status = document.getElementById('contact-status');
    if (!(form instanceof HTMLFormElement) || !submitBtn || !status) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      status.textContent = 'sending…';
      status.classList.remove('text-green', 'text-red');

      try {
        const res = await fetch('/api/sendMail', {
          method: 'POST',
          body: new FormData(form),
        });
        const result = await res.json();

        if (result.ok) {
          status.textContent = 'sent — thanks!';
          status.classList.add('text-green');
          form.reset();
        } else {
          status.textContent = 'error sending, try again later';
          status.classList.add('text-red');
        }
      } catch {
        status.textContent = 'error sending, try again later';
        status.classList.add('text-red');
      } finally {
        submitBtn.disabled = false;
      }
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
