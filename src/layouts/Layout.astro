---
import '../styles/global.css';

interface Props {
  title?:       string;
  description?: string;
}

const {
  title       = 'propstgonz',
  description = 'IT student from Galicia tinkering with things since forever.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080B10" />
    <meta property="og:image" content="/metaimage.png" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Preload the avatar so it's fetched before the browser hits the <img> tag.
      The image lives in public/ and is served with long-lived cache headers via Traefik.
      fetchpriority="high" bumps it to the top of the network queue.
    -->
    <link
      rel="preload"
      as="image"
      href="/propstplaceholder.png"
      fetchpriority="high"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
