---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { marked } from 'marked';
import { getPosts, getPostContent } from '../../lib/api';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/blog');

let html  = '';
let title = slug.replace(/-/g, ' ');

try {
  // Get all posts to find the matching URL
  const posts = await getPosts();
  const match = posts.find(p => {
    const name = p.url.split('/').pop()?.replace(/\.md$/, '');
    return name === slug;
  });

  if (!match) return Astro.redirect('/blog');

  // Fetch the post content
  const markdown = await getPostContent(match.url);

  // Extract title from first H1
  const h1 = markdown.match(/^#\s+(.+)/m);
  if (h1) title = h1[1];

  // Strip the H1 so BlogPost.astro renders it as its own heading
  const body = h1 ? markdown.replace(/^#\s+.+\n?/m, '') : markdown;
  html = await marked(body);

} catch {
  return Astro.redirect('/blog');
}
---

<BlogPostLayout title={title}>
  <a href="/blog" class="back">← Back to blog</a>
  <BlogPost html={html} title={title} />
</BlogPostLayout>

<style>
  .back {
    display:         inline-block;
    font-size:       12px;
    color:           var(--text2);
    text-decoration: none;
    margin-bottom:   24px;
  }
  .back:hover { color: var(--amber); }
</style>
