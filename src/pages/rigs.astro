---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PCInfo from '../components/PCInfo.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { computers } from '../data/computers';
---
<Layout title="rigs — propstgonz" description="My machines: hardware, OS and self-hosting setup.">
  <Header activePage="/rigs" />

  <main id="main" class="max-w-page mx-auto px-5 pb-16">
    <SectionHeader title="rigs" as="h1" class="mb-4" />
    <div class="flex flex-col gap-4">
      {computers.map(pc => <PCInfo pc={pc} />)}
    </div>
  </main>

  <Footer />
</Layout>
