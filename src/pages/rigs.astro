---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PCInfo from '../components/PCInfo.astro';
import Tools from '../components/Tools.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { computers } from '../data/computers';
---
<Layout title="rigs — propstgonz" description="Hardware, stack and self-hosting setup.">
  <Header activePage="/rigs" />

  <main id="main" class="max-w-page mx-auto px-5 pb-16 flex flex-col gap-8">

    <section>
      <SectionHeader title="rigs" as="h1" class="mb-4" />
      <div class="flex flex-col gap-4">
        {computers.map(pc => <PCInfo pc={pc} />)}
      </div>
    </section>

    <Tools />

    <a href="/faq" class="btn-cta group">
      <div class="min-w-0">
        <SectionHeader title="faq" rule={false} class="mb-2" />
        <p class="text-sm text-text2 font-mono">Common questions, answered</p>
      </div>
      <span class="btn-cta-arrow" aria-hidden="true">→</span>
    </a>

  </main>

  <Footer />
</Layout>
