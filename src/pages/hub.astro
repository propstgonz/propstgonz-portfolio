---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hub from '../components/Hub.astro';

const cards = [
  {
    title:       'Baronette.es',
    description: 'Main domain landing page.',
    href:        'https://baronette.es',
    img:         'https://baronette.es/_image?href=%2F_astro%2FBaronette-minimalista-cuadrado.Bjgv9ofB.png&w=800&h=800&f=webp',
    tag:         'web',
    external:    true,
  },
  {
    title:       'GitHub',
    description: 'All my repos, projects and contributions.',
    href:        'https://github.com/propstgonz',
    img:         'https://github.githubassets.com/assets/GitHub-Mark-ea2971cee799.png',
    tag:         'code',
    external:    true,
  },
  {
    title:       'My computers',
    description: 'Hardware specs and system info.',
    href:        '/computers',
    tag:         'hardware',
    external:    false,
  },
  {
    title:       'Blog',
    description: 'Occasional write-ups when I feel like it.',
    href:        '/blog',
    tag:         'writing',
    external:    false,
  },
  {
    title:       'FAQ',
    description: 'Questions and the answers nobody asked for.',
    href:        '/faq',
    tag:         'meta',
    external:    false,
  },
  {
    title:       'Projects',
    description: 'Deployed services and experiments.',
    href:        '/projects',
    tag:         'projects',
    external:    false,
  },
];
---

<Layout title="Hub — propstgonz">
  <Header activePage="/hub" />

  <main class="page">
    <div class="sec-hd" style="margin-bottom: 24px;">
      <span class="sec-hd-bar"></span>
      <span class="sec-hd-title">Hub</span>
      <span class="sec-hd-rule"></span>
      <span class="note">everything in one place</span>
    </div>

    <Hub cards={cards} />
  </main>

  <Footer />
</Layout>

<style>
  .page  { max-width: 880px; margin: 0 auto; padding: 28px 20px; }
  .note  { font-size: 10px; color: var(--text3); white-space: nowrap; }
</style>
