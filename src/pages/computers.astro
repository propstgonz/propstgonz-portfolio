---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PCInfo from '../components/PCInfo.astro';
import { computers } from '../data/computers';
---

<Layout title="Computers — propstgonz">
  <Header activePage="/computers" />

  <main class="page">
    <div class="sec-hd" style="margin-bottom: 24px;">
      <span class="sec-hd-bar"></span>
      <span class="sec-hd-title">My machines</span>
      <span class="sec-hd-rule"></span>
      <span class="note">yes I name them</span>
    </div>

    <ul class="pc-grid">
      {computers.map(pc => (
        <li><PCInfo pc={pc} /></li>
      ))}
    </ul>
  </main>

  <Footer />
</Layout>

<style>
  .page    { max-width: 880px; margin: 0 auto; padding: 28px 20px; }
  .note    { font-size: 10px; color: var(--text3); white-space: nowrap; }
  .pc-grid {
    display:               grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap:                   14px;
    list-style:            none;
  }
</style>
