---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutMe from '../components/AboutMe.astro';
import Socials from '../components/Socials.astro';
import ClickCounter from '../components/ClickCounter.astro';
import IP from '../components/IP.astro';
import Logs from '../components/Logs.astro';
import Tools from '../components/Tools.astro';
import ContForm from '../components/ContForm.astro';
import Philosophy from '../components/Philosophy.astro';
import BlogHighlight from '../components/BlogHighlight.astro';
import RigsHighlight from '../components/RigsHighlight.astro';
---
<Layout title="propstgonz">
  <Header activePage="/" />

  <div class="max-w-[880px] mx-auto px-5 pb-16 grid grid-cols-1 sm:grid-cols-[240px_1fr] gap-8">

    <aside class="flex flex-col gap-6">
      <AboutMe />
      <Socials />
      <ClickCounter />
      <IP />
    </aside>

    <main class="flex flex-col gap-6 min-w-0">
      <BlogHighlight />
      <Philosophy />
      <ContForm />
      <Logs />
      <Tools />
      <RigsHighlight />
    </main>
  </div>

  <Footer />
</Layout>
