---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InProgress from '../components/InProgress.astro';
---

<Layout title="Projects — propstgonz">
  <Header activePage="/projects" />

  <main class="page">
    <div class="sec-hd" style="margin-bottom: 24px;">
      <span class="sec-hd-bar"></span>
      <span class="sec-hd-title">Projects</span>
      <span class="sec-hd-rule"></span>
    </div>

    <InProgress label="Projects" />
  </main>

  <Footer />
</Layout>

<style>
  .page { max-width: 880px; margin: 0 auto; padding: 28px 20px; }
</style>
