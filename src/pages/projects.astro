---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { projects } from '../data/projects';

const linksOf = (p: (typeof projects)[number]) =>
  [
    p.repo && { href: p.repo, label: 'source' },
    p.extraRepo && { href: p.extraRepo, label: 'backend' },
    p.live && { href: p.live, label: 'live' },
  ].filter((l): l is { href: string; label: string } => Boolean(l));
---
<Layout title="projects — propstgonz" description="Things I've built: tools, self-hosting setups and websites.">
  <Header activePage="/projects" />

  <main id="main" class="max-w-page mx-auto px-5 pb-16 flex flex-col gap-8">
    <SectionHeader title="projects" as="h1" />

    <div class="flex flex-col gap-4">
      {projects.map(p => (
        <article class="card p-5 sm:p-6 font-mono">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 mb-2">
            <h2 class="text-lg font-bold text-amber wrap-anywhere">{p.name}</h2>
            <ul class="flex gap-4 text-xs">
              {linksOf(p).map(l => (
                <li>
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-cyan underline decoration-cyan/40 underline-offset-2 hover:decoration-cyan transition-colors"
                  >{l.label} ↗</a>
                </li>
              ))}
            </ul>
          </div>

          <p class="text-sm text-text mb-3">{p.tagline}</p>
          <p class="text-sm text-text2 leading-relaxed max-w-[68ch] mb-4">{p.description}</p>

          <ul class="flex flex-col gap-1.5 text-sm text-text2 leading-relaxed max-w-[68ch] mb-5">
            {p.highlights.map(h => (
              <li class="flex gap-2.5">
                <span class="text-amber shrink-0" aria-hidden="true">→</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>

          <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
            {p.stack.map(s => <li class="tag">{s}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <a href="https://github.com/propstgonz" target="_blank" rel="noopener noreferrer" class="btn-cta group">
      <div class="min-w-0">
        <SectionHeader title="github" rule={false} class="mb-2" />
        <p class="text-sm text-text2 font-mono">More repos at github.com/propstgonz</p>
      </div>
      <span class="btn-cta-arrow" aria-hidden="true">↗</span>
    </a>
  </main>

  <Footer />
</Layout>
