---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 — propstgonz">
  <Header />

  <main class="page">
    <div class="err-wrap">
      <img
        src="/assets/img/technical-difficulties-tenna.gif"
        alt="Technical difficulties"
        class="err-gif"
        loading="eager"
      />
      <h1 class="err-code">404</h1>
      <p class="err-msg">Page not found.</p>
      <p class="err-sub">Whatever you were looking for, I probably didn't make it yet.</p>
      <a href="/" class="err-link">← Go home</a>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page     { max-width: 880px; margin: 0 auto; padding: 60px 20px; }

  .err-wrap {
    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    text-align:      center;
    gap:             12px;
  }

  .err-gif  { max-width: 280px; border-radius: 8px; margin-bottom: 8px; }
  .err-code { font-size: 64px; font-weight: 700; color: var(--amber); font-family: var(--mono); line-height: 1; }
  .err-msg  { font-size: 16px; color: var(--text); font-weight: 500; }
  .err-sub  { font-size: 13px; color: var(--text2); }
  .err-link { font-size: 12px; color: var(--cyan); text-decoration: none; margin-top: 8px; }
  .err-link:hover { text-decoration: underline; }
</style>
