---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPostSummaries } from '../lib/api';
import type { PostSummary } from '../types/post';

let posts: PostSummary[] = [];
let error = false;

try {
  posts = await getPostSummaries();
} catch {
  error = true;
}
---
<Layout title="blog — propstgonz">
  <Header activePage="/blog" />

  <main class="max-w-[860px] mx-auto px-5 pb-16">
    <div class="sec-hd mb-5">
      <span class="sec-hd-bar"></span>
      <span class="sec-hd-title">blog</span>
      <span class="sec-hd-rule"></span>
    </div>

    {error && (
      <p class="text-[13px] text-text2 font-mono">Could not load posts right now. Try again later.</p>
    )}

    {!error && posts.length === 0 && (
      <p class="text-[13px] text-text2 font-mono">Nothing here yet. Check back later.</p>
    )}

    <ul class="flex flex-col gap-3 list-none p-0 m-0">
      {posts.map(post => (
        <li>
          <a href={`/posts/${post.slug}`} class="card group flex gap-4 p-4 no-underline text-text hover:border-amber-d hover:-translate-y-0.5 hover:shadow-[0_10px_30px_-10px_rgba(217,144,88,0.35)]">
            {post.image?.url && (
              <img
                src={post.image.url}
                alt={post.image.alt}
                loading="lazy"
                class="w-24 h-24 sm:w-28 sm:h-28 shrink-0 rounded-lg object-contain bg-b1 border border-b1"
              />
            )}
            <div class="min-w-0 flex flex-col justify-center gap-1.5 py-1">
              <span class="text-base font-semibold font-mono text-text capitalize truncate">{post.title}</span>
              {post.description && (
                <span class="text-[13px] text-text2 leading-relaxed line-clamp-2">{post.description}</span>
              )}
            </div>
            <span class="text-text3 text-lg group-hover:text-amber group-hover:translate-x-1 transition-all shrink-0 self-center ml-auto" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</Layout>
