---
import Layout from '../layouts/Layout.astro';
import BlogPost from '../components/BlogPost.astro';
import { fetchPosts } from './api/api.ts';
import matter from 'gray-matter';

const { posts, hasError } = await fetchPosts();

let allPosts: { id: string; url: string; frontmatter: any; }[] = [];

if (!hasError) {
  allPosts = await Promise.all(
    posts.map(async (post) => {
      try {
        const mdRes = await fetch(post.url);
        if (!mdRes.ok) throw new Error(`Failed to fetch ${post.url}`);
        const mdText = await mdRes.text();
        const { data: frontmatter } = matter(mdText);
        return {
          id: post.id,
          url: post.url,
          frontmatter,
        };
      } catch (err) {
        console.warn(`Failed to parse post ${post.id}:`, err);
        return {
          id: post.id,
          url: post.url,
          frontmatter: { title: 'Error loading post', date: new Date() },
        };
      }
    })
  );

  allPosts = allPosts.sort(
    (a, b) =>
      new Date(b.frontmatter.pubDate).getTime() -
      new Date(a.frontmatter.pubDate).getTime()
  );
}

const PAGE_PROPS = {
  title: 'Blog',
  description: "Alejandro Propst's logbook",
  image: '/logbook.png',
};

export const revalidate = 3600;
---

<Layout {...PAGE_PROPS}>
  <section class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8 text-center">
      Welcome to my blog entries
      <span class="block text-lg text-gray-500">
        (In Spanish cuz I'm so lazy to write them in English)
      </span>
    </h1>

    {hasError ? (
      <p class="text-red-500 text-center">Error al cargar los posts.</p>
    ) : (
      <div class="flex flex-col gap-6">
        {allPosts.map((post) => {
          const dateObj = new Date(post.frontmatter.date);
          const hasValidDate =
            post.frontmatter.date && !isNaN(dateObj.getTime());

            return (
              <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-5 hover:shadow-lg hover:bg-gray-700 transition-all">
                <a href={`/posts/${post.id}`}>
                  <li>{post.frontmatter.title}</li>
                  {hasValidDate && (
                    <p class="text-sm text-gray-500 mt-1">
                      {dateObj.toLocaleDateString('es-ES', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </p>
                  )}
                </a>
              </div>
            );
          })}
        </div>
      )
    }

    <button
      onclick="window.location.href='/'"
      class="fixed bottom-4 right-4 px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-lg shadow hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors z-50"
    >
      ← Return to index
    </button>
  </section>
</Layout>
