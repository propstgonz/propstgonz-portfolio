---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPosts } from '../lib/api';

let posts: { id: string; url: string }[] = [];
let error = false;

try {
  posts = await getPosts();
} catch {
  error = true;
}

// Extract a readable slug from the URL (last path segment without extension)
function slugFrom(url: string): string {
  const seg = url.split('/').pop() ?? url;
  return seg.replace(/\.md$/, '').replace(/-/g, ' ');
}
---

<Layout title="Blog — propstgonz">
  <Header activePage="/blog" />

  <main class="page">
    <div class="sec-hd" style="margin-bottom: 20px;">
      <span class="sec-hd-bar"></span>
      <span class="sec-hd-title">Blog</span>
      <span class="sec-hd-rule"></span>
    </div>

    {error && (
      <p class="err">Could not load posts right now. Try again later.</p>
    )}

    {!error && posts.length === 0 && (
      <p class="empty">Nothing here yet. Check back later.</p>
    )}

    <ul class="post-list">
      {posts.map(post => {
        const slug = post.url.split('/').pop()?.replace(/\.md$/, '') ?? post.id;
        return (
          <li>
            <a href={`/posts/${slug}`} class="post-card card">
              <span class="post-title">{slugFrom(post.url)}</span>
              <span class="post-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ul>
  </main>

  <Footer />
</Layout>

<style>
  .page { max-width: 860px; margin: 0 auto; padding: 28px 20px; }

  .post-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }

  .post-card {
    display:         flex;
    justify-content: space-between;
    align-items:     center;
    padding:         14px 16px;
    text-decoration: none;
    color:           var(--text);
    transition:      border-color .15s, color .15s;
  }

  .post-card:hover { border-color: var(--amber-d); color: var(--amber); }

  .post-title {
    font-size:   14px;
    text-transform: capitalize;
  }

  .post-arrow { color: var(--text3); font-size: 16px; }
  .post-card:hover .post-arrow { color: var(--amber); }

  .err, .empty { font-size: 13px; color: var(--text2); }
</style>
