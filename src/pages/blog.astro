---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPosts, slugFromUrl } from '../lib/api';

let posts: { id: string; url: string }[] = [];
let error = false;

try {
  posts = await getPosts();
} catch {
  error = true;
}

function readableTitle(url: string): string {
  return slugFromUrl(url).replace(/-/g, ' ');
}
---
<Layout title="blog — propstgonz">
  <Header activePage="/blog" />

  <main class="max-w-[860px] mx-auto px-5 pb-16">
    <div class="sec-hd mb-5">
      <span class="sec-hd-bar"></span>
      <span class="sec-hd-title">blog</span>
      <span class="sec-hd-rule"></span>
    </div>

    {error && (
      <p class="text-[13px] text-text2 font-mono">Could not load posts right now. Try again later.</p>
    )}

    {!error && posts.length === 0 && (
      <p class="text-[13px] text-text2 font-mono">Nothing here yet. Check back later.</p>
    )}

    <ul class="flex flex-col gap-2 list-none p-0 m-0">
      {posts.map(post => {
        const slug = slugFromUrl(post.url);
        return (
          <li>
            <a href={`/posts/${slug}`} class="btn-cta group no-underline text-text">
              <span class="text-sm font-mono capitalize">{readableTitle(post.url)}</span>
              <span class="text-text3 text-lg group-hover:text-amber group-hover:translate-x-1 transition-all shrink-0" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ul>
  </main>

  <Footer />
</Layout>
