---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LinkCategoryBlock from '../components/LinkCategoryBlock.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { linkCategories } from '../data/links';
---
<Layout title="links — propstgonz" description="Sites I like and visit often.">
  <Header activePage="/links" />

  <main id="main" class="max-w-page mx-auto px-5 pb-16 flex flex-col gap-8">
    <SectionHeader title="links" as="h1">
      <span class="text-xs text-text3 whitespace-nowrap font-mono">sites I like</span>
    </SectionHeader>

    {linkCategories.map(category => <LinkCategoryBlock category={category} />)}
  </main>

  <Footer />
</Layout>
