# SMTP for the contact form
SMTP_HOST="mail.baronette.es"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
CONTACT_TO=propstgonz@baronette.es

# Blog posts API (propstgonz-portfolio-backend). Both containers share
# the 'traefik-net' Docker network, so the internal container hostname
# is used instead of the public baronette.es:3742 URL — it's faster and
# avoids relying on the host's NAT looping back to itself.
POSTS_API_ENDPOINT="http://propstgonz-backend:3000/api/posts"

# The backend's /api/posts response returns { id, url } pairs, but the
# url in each one points at a DIFFERENT origin — the nginx "bucket"
# service that actually serves the markdown files, not the API itself.
# Comma-separated list of origins allowed to be fetched for post content
# (SSRF guard — POSTS_API_ENDPOINT's own origin is always allowed too).
POSTS_CONTENT_ORIGINS="https://bucket.baronette.es"

# Where the click counter's JSON file lives. Optional locally (falls
# back to a tmp path); Docker sets this via docker-compose.yml, pointing
# at a bind-mounted host directory instead.
COUNTER_FILE=/tmp/propstgonz-counter.json
