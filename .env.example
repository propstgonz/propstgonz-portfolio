# SMTP for the contact form
SMTP_HOST="email.baronette.es"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# Where contact form messages are delivered
CONTACT_TO=propstgonz@baronette.es

# Backend posts API (internal Docker hostname)
POSTS_API_ENDPOINT="http://propstgonz-backend:3000/api/posts"
# Origins allowed to serve post content (SSRF guard)
POSTS_CONTENT_ORIGINS="https://bucket.baronette.es"

# Click counter JSON. Docker points this at the mounted volume
COUNTER_FILE=/tmp/propstgonz-counter.json
# Visitor metrics JSON. Same volume as the counter
METRICS_FILE=/tmp/propstgonz-metrics.json
# Weekly report recipient. Empty disables the report
METRICS_REPORT_TO=""
