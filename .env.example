# SMTP for the contact form
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=propstgonz@baronette.es

# External blog posts endpoint (markdown files), leave empty to disable blog
POSTS_API_ENDPOINT=

# Optional locally (Docker sets this via docker-compose.yml)
COUNTER_FILE=/tmp/propstgonz-counter.json
